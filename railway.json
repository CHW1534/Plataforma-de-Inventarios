{
  "$schema": "https://railway.app/railway.schema.json",
  "services": {
    "backend": {
      "name": "inventario-backend",
      "source": {
        "rootDirectory": "backend"
      },
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "Dockerfile"
      },
      "deploy": {
        "numReplicas": 1,
        "sleepService": false
      }
    },
    "frontend": {
      "name": "inventario-frontend",
      "source": {
        "rootDirectory": "frontend"
      },
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "Dockerfile"
      },
      "deploy": {
        "numReplicas": 1,
        "sleepService": false
      }
    }
  }
}
