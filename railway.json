{
  "$schema": "https://railway.app-railway.json.schema.json",
  "build": {
    "builder": "DOCKERFILE"
  },
  "deploy": {
    "numReplicas": 1
  },
  "services": {
    "backend": {
      "name": "inventario-backend",
      "source": {
        "rootDirectory": "backend"
      }
    },
    "frontend": {
      "name": "inventario-frontend",
      "source": {
        "rootDirectory": "frontend"
      }
    }
  }
}
